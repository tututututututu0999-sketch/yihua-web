# 将本文件复制为 .env，并只在 .env 中填写真实密钥。不要把 .env 提交到代码仓库。
CCPROXY_API_KEY=请在这里填写你的APIKey
CCPROXY_BASE_URL=https://ccproxy.yukework.com
CCPROXY_MODEL=gpt-5.6-terra
CCPROXY_IMAGE_MODEL=gpt-image-2
CCPROXY_IMAGE_INPUT_FIDELITY=medium
# 服务商图片编辑接口的多图字段名；默认 image[]。若服务端只接受 image，请改为 image。
CCPROXY_EDIT_IMAGE_FIELD=image[]
