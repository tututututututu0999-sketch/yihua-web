# 将本文件复制为 .env，并只在 .env 中填写真实密钥。不要把 .env 提交到代码仓库。
CCPROXY_API_KEY=请在这里填写你的APIKey
CCPROXY_BASE_URL=https://ccproxy.yukework.com
CCPROXY_MODEL=gpt-5.6-terra
# Prompt Skill uses faster text models independently from the image workflow.
CCPROXY_PROMPT_MODEL=gpt-5.4
CCPROXY_PROMPT_RECOVERY_MODEL=gpt-5.4
CCPROXY_PROMPT_TIMEOUT_MS=35000
# Prompt Skill first uses a compact request, then retries with an even smaller
# recovery request to reduce provider queueing and avoid unnecessary fallback.
CCPROXY_PROMPT_MAX_TOKENS=420
CCPROXY_PROMPT_RECOVERY_TIMEOUT_MS=40000
CCPROXY_PROMPT_RECOVERY_MAX_TOKENS=320
# Other text workflows can use a larger output budget.
CCPROXY_CHAT_MAX_TOKENS=900
# Keep false by default. Reference assets remain available to image generation;
# set true only when the configured text model has reliable vision support.
CCPROXY_PROMPT_VISION=false
CCPROXY_IMAGE_MODEL=gpt-image-2
CCPROXY_IMAGE_INPUT_FIDELITY=medium
# 服务商图片编辑接口的多图字段名；默认 image[]。若服务端只接受 image，请改为 image。
CCPROXY_EDIT_IMAGE_FIELD=image[]
# 编辑参考图会统一压缩为 JPEG，保留完整画面以减少图片接口的格式、透明通道和体积拒绝。
CCPROXY_EDIT_REFERENCE_EDGE=1536
CCPROXY_EDIT_REFERENCE_COUNT=3
# 生图接口使用“整合版提示词 + 必要硬约束”，避免完整 Skill 规则正文超过编辑模型限制。
CCPROXY_IMAGE_EDIT_PROMPT_MAX_CHARS=1200
# 浏览器上传图片会先压缩；此项是本地服务单次 JSON 请求的兜底上限（16-48 MB）。
YIHUA_MAX_REQUEST_MB=24
